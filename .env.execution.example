# Optional Python execution service settings. Keep real credentials only in .env.
# The tested development default is the public Judge0 CE endpoint.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_PYTHON_LANGUAGE_ID=100
# For a self-hosted instance with token authentication:
# JUDGE0_AUTH_TOKEN=
# For a RapidAPI instance, set its URL above and its key below:
# JUDGE0_RAPIDAPI_KEY=
